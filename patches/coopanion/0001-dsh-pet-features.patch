+/* ---------- start at login ---------- */
+/**
+ * Started by the system at login: the pet and the tray show, but no window opens on its own.
+ * `--set-autostart=on|off` (what `tools/coopanion-autostart.*` calls) only writes the entry and
+ * leaves; it runs before the single-instance lock, so it also works while the app is already up.
+ */
+const BACKGROUND = process.argv.includes('--background');
+/** What starts this app the way it is running now: Electron is only the runtime when unpackaged. */
+const START_ARGS = app.isPackaged ? ['--background'] : [APP_ROOT, '--background'];
+/**
+ * The login entry. Electron's login items cover Windows and macOS; on Linux it is an XDG autostart
+ * file (~/.config/autostart/coopanion.desktop) that runs the AppImage, or the installed executable.
+ * The tray's switch and the launcher scripts both come through here, so there is one entry only.
+ */
+const AUTOSTART = join(app.getPath('home'), '.config', 'autostart', 'coopanion.desktop');
+const autostart = {
+  get: () => (LINUX ? existsSync(AUTOSTART) : app.getLoginItemSettings({ path: process.execPath, args: START_ARGS }).openAtLogin),
+  set(on) {
+    if (!LINUX) { app.setLoginItemSettings({ openAtLogin: on, path: process.execPath, args: START_ARGS }); return; }
+    if (!on) { rmSync(AUTOSTART, { force: true }); return; }
+    const exe = process.env.APPIMAGE || process.execPath;
+    const args = app.isPackaged ? ' --background' : ` "${APP_ROOT}" --background`;
+    mkdirSync(dirname(AUTOSTART), { recursive: true });
+    writeFileSync(AUTOSTART, `[Desktop Entry]\nType=Application\nName=Coopanion\nExec="${exe}"${args}\nX-GNOME-Autostart-enabled=true\n`);
+  },
+};
+
+const autostartFlag = process.argv.find((a) => a.startsWith('--set-autostart='));
+if (autostartFlag) {
+  const on = autostartFlag.slice('--set-autostart='.length) !== 'off';
+  app.whenReady().then(() => {
+    try {
+      autostart.set(on);
+      console.log(`Coopanion 开机自启: ${autostart.get() ? '已开启' : '已关闭'}`);
+    } catch (err) {
+      console.error(`Coopanion 开机自启没设成:${err.message}`);
+      app.exit(1);
+      return;
+    }
+    app.exit(0);
+  });
+  return;
+}
