<Window x:Class="XNoteWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="便签桌面栏"
        FontFamily="Microsoft YaHei UI"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Topmost="True"
        Width="360" Height="425"
        PreviewMouseWheel="OnMouseWheel"
        PreviewMouseLeftButtonDown="OnMouseDown"
        PreviewMouseLeftButtonUp="OnMouseUp"
        PreviewMouseMove="OnMouseMove"
        ManipulationStarting="OnManipulationStarting"
        ManipulationStarted="OnManipulationStarted"
        ManipulationDelta="OnManipulationDelta"
        ManipulationInertiaStarting="OnManipulationInertiaStarting">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="新建便签" Click="CtxAdd_Click"/>
            <MenuItem Header="设置" Click="CtxSettings_Click"/>
            <MenuItem Header="隐藏到托盘" Click="CtxHide_Click"/>
            <Separator/>
            <MenuItem Header="退出" Click="CtxExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Border Margin="9">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Direction="270" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Border CornerRadius="16"
                Background="{StaticResource WindowBgBrush}"
                BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>

                <!-- ===== 标题栏 ===== -->
                <Grid Grid.Row="0" Background="#10FFFFFF" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Width="11" Height="11" CornerRadius="5.5" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Border.Background>
                                <RadialGradientBrush>
                                    <GradientStop Color="#FDE047" Offset="0"/>
                                    <GradientStop Color="#D97706" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="9" ShadowDepth="0" Color="#FBBF24" Opacity="0.9"/>
                            </Border.Effect>
                        </Border>
                        <StackPanel>
                            <TextBlock x:Name="HeaderTitle" Text="便签" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="HeaderSubtitle" Text="桌面便签" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,10,0" VerticalAlignment="Center">
                        <Button x:Name="BtnAdd" Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="新建便签" Click="BtnAdd_Click"/>
                        <Button x:Name="BtnSettings" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="设置" Click="BtnSettings_Click"/>
                        <Button x:Name="BtnHide" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="隐藏到托盘" Click="BtnHide_Click"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#1CFFFFFF"/>

                <!-- ===== 便签列表 ===== -->
                <Grid Grid.Row="2">
                    <StackPanel x:Name="BarsHost" Margin="12,10,12,8" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="BarsSlide"/>
                        </StackPanel.RenderTransform>
                    </StackPanel>
                </Grid>

                <!-- ===== 状态栏 ===== -->
                <Grid Grid.Row="3" Background="#12FFFFFF">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HintText" Text="点击编辑 · 回车×2 新建 · 左划删除"
                               Margin="14,0,0,0" FontSize="10" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CountText" Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center"
                               FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
