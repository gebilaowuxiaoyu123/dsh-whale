{
  "name": "dsh-whale-desktop-linux",
  "version": "1.0.0",
  "description": "DSH 小鲸鱼桌面挂件 - Ubuntu 22.04/24.04 amd64 版（本地自包含，首次运行自动配置）",
  "main": "main.js",
  "author": "dsh-whale",
  "homepage": "https://github.com/gebilaowuxiaoyu123/dsh-whale",
  "desktopName": "dsh-whale-widget.desktop",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux",
    "dist:appimage": "electron-builder --linux AppImage",
    "dist:deb": "electron-builder --linux deb"
  },
  "license": "MIT",
  "build": {
    "appId": "com.dsh.whalewidget",
    "productName": "DSH Whale Widget",
    "asar": true,
    "files": [
      "main.js",
      "host-shim.js",
      "preload.js",
      "preload-linux.js",
      "widget.js",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dsh-whale-widget",
        "to": "dsh-whale-widget",
        "filter": [
          "lib/**",
          "assets/**",
          "package.json",
          "LICENSE",
          "PROVENANCE.md"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "dsh-whale",
      "synopsis": "DSH 小鲸鱼桌面挂件",
      "artifactName": "dsh-whale-widget-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3"
  }
}
