<UserControl x:Class="XSpaceWidget.Controls.NoticeColumn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XSpaceWidget.Controls"
             FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="26"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 列头：名称 + 状态点 / 页码 ===== -->
        <Grid Grid.Row="0" Margin="13,0,11,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="ColDot" Width="6" Height="6" VerticalAlignment="Center"
                     Fill="{Binding Accent, RelativeSource={RelativeSource AncestorType={x:Type local:NoticeColumn}}}"/>
            <TextBlock x:Name="ColTitle" Grid.Column="1" Margin="6,0,6,0"
                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ColPage" Grid.Column="2" FontSize="10" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Grid>

        <!-- 键盘当前作用列指示：列头下方一条强调色细线 -->
        <Border x:Name="FocusLine" Grid.Row="0" Margin="11,0,11,0" Height="2" CornerRadius="1"
                VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False"
                Background="{Binding Accent, RelativeSource={RelativeSource AncestorType={x:Type local:NoticeColumn}}}"/>

        <!-- ===== 列表（裁切；滚动时多渲染的那条被剪掉） ===== -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <StackPanel x:Name="BarsHost" Margin="11,0,11,0" VerticalAlignment="Top"/>

            <!-- 空态 / 错误提示 -->
            <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" Margin="16,0"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="EmptyText" Text="正在获取…" FontSize="11.5"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
